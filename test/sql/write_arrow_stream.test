# name: test/sql/write_arrow_stream.test
# description: test nanoarrow extension
# group: [sql]

# Require statement will ensure this test is run with this extension loaded
require nanoarrow

test-env DATA_PATH {TEST_DIR}

statement ok
CREATE TABLE test AS SELECT * FROM read_arrow('__WORKING_DIRECTORY__/data/test.arrows');

statement ok
COPY test TO '{DATA_PATH}/test.arrows' (FORMAT ARROWS, BATCH_SIZE 100)

statement ok
CREATE OR REPLACE TABLE written AS SELECT * FROM read_arrow('{DATA_PATH}/test.arrows');

query I
SELECT count(*) FROM read_arrow('{DATA_PATH}/test.arrows');
----
15487

query I
SELECT sum((test.time = written.time)::INTEGER) FROM test INNER JOIN written ON test.commit = written.commit;
----
15487

# ENUMs, nested ones too, are written dictionary encoded and read back as VARCHAR
statement ok
CREATE TYPE mood AS ENUM ('happy', 'sad');

statement ok
COPY (SELECT 'happy'::mood AS m, {'m': 'sad'::mood} AS s) TO '{DATA_PATH}/enum.arrows' (FORMAT ARROWS, COMPRESSION ZSTD);

query II
FROM read_arrow('{DATA_PATH}/enum.arrows');
----
happy	{'m': sad}

query I
SELECT count(*) FROM to_arrow_ipc((SELECT {'m': 'happy'::mood}), compression := 'lz4');
----
2

# String views cannot be written yet, the error must not be an internal one
statement ok
SET arrow_output_version = '1.5';

statement ok
SET produce_arrow_string_view = true;

statement error
COPY (SELECT 'abc' AS s) TO '{DATA_PATH}/string_view.arrows' (FORMAT ARROWS);
----
Not implemented Error

statement error
SELECT count(*) FROM to_arrow_ipc((SELECT 'abc' AS s));
----
Not implemented Error

statement ok
SET produce_arrow_string_view = false;

statement ok
RESET arrow_output_version;
