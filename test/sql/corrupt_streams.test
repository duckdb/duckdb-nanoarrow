# name: test/sql/corrupt_streams.test
# description: reading truncated and corrupted Arrow IPC streams fails cleanly
# group: [sql]

require nanoarrow

test-env DATA_PATH {TEST_DIR}

# A stream may stop at a message boundary without the end of stream marker
query II
SELECT count(*), sum(i) FROM read_arrow('__WORKING_DIRECTORY__/data/corrupt/missing_eos_zstd.arrows');
----
200	19900

# A stream that ends inside a message is truncated, whether or not it is compressed
foreach file truncated_body_zstd truncated_body_none truncated_prefix_zstd

statement error
SELECT count(*) FROM read_arrow('__WORKING_DIRECTORY__/data/corrupt/${file}.arrows');
----
Arrow IPC stream is truncated

endloop

# A recorded uncompressed length does not match the codec output, which only a column read decompresses
statement error
SELECT sum(i) FROM read_arrow('__WORKING_DIRECTORY__/data/corrupt/bad_body_zstd.arrows');
----
ZSTD_decompress

statement error
SELECT sum(i) FROM read_arrow('__WORKING_DIRECTORY__/data/corrupt/bad_body_lz4.arrows');
----
LZ4 frame

# Validate the message length before allocating or reading metadata.
statement ok
COPY (SELECT unhex('FFFFFFFFFFFFFFFF')) TO '{DATA_PATH}/negative_length.arrows' (FORMAT BLOB);

statement error
FROM read_arrow('{DATA_PATH}/negative_length.arrows');
----
Expected message size > 0

# An invalid FlatBuffer root offset must fail before decoding the schema.
statement ok
COPY (SELECT unhex('FFFFFFFF08000000F0FFFF7F00000000')) TO '{DATA_PATH}/bad_header.arrows' (FORMAT BLOB);

statement error
FROM read_arrow('{DATA_PATH}/bad_header.arrows');
----
Message flatbuffer verification failed

# A batch without a body must not reuse the previous body, that silently duplicated rows
statement error
FROM read_arrow('__WORKING_DIRECTORY__/data/corrupt/zero_body.arrows');
----
body has size 0

# The errors above leave the database usable
query I
SELECT 42;
----
42

# A remote stream is read ahead in order, and counting its rows still notices the cut
foreach file truncated_body_zstd truncated_body_none truncated_prefix_zstd

statement ok
COPY (SELECT content FROM read_blob('{WORKING_DIRECTORY}/data/corrupt/{file}.arrows')) TO '{DATA_PATH}/{file}.arrows' (FORMAT BLOB);

statement error
SELECT count(*) FROM read_arrow('{DATA_PATH}/{file}.arrows');
----
Arrow IPC stream is truncated

endloop
