<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.duckdb.nanoarrow</groupId>
  <artifactId>nanoarrow-java-tests</artifactId>
  <version>0.0.1</version>
  <name>duckdb-nanoarrow Java tests</name>
  <description>Reads files the nanoarrow extension writes with arrow-java</description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The version peak_read_memory_bytes is modelled on -->
    <arrow.version>16.1.0</arrow.version>
    <junit.version>5.10.2</junit.version>
    <duckdb.shell>${project.basedir}/../../build/release/duckdb</duckdb.shell>
    <duckdb.extension>${project.basedir}/../../build/release/extension/nanoarrow/nanoarrow.duckdb_extension</duckdb.extension>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-vector</artifactId>
      <version>${arrow.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-compression</artifactId>
      <version>${arrow.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-memory-netty</artifactId>
      <version>${arrow.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-memory-unsafe</artifactId>
      <version>${arrow.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>2.0.13</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <!-- arrow-java reaches into java.nio for its direct buffers -->
          <argLine>--add-opens=java.base/java.nio=ALL-UNNAMED</argLine>
          <systemPropertyVariables>
            <duckdb.shell>${duckdb.shell}</duckdb.shell>
            <duckdb.extension>${duckdb.extension}</duckdb.extension>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
